# OpenRouter 자격증명 템플릿.
#
# 사용법: 이 파일을 key.env로 복사하고 실제 키를 채운다.
#     cp key.env.example key.env
#
# key.env는 .gitignore가 막고 있으므로 절대 커밋되지 않는다(key*.env).
# 이 예시 파일에는 진짜 키를 넣지 말 것.

OPENROUTER_API_KEY=sk-or-여기에-실제-키

# 캡션에 쓸 비전 모델. OpenRouter의 모델 목록은 수시로 바뀌므로 상수로
# 박지 않고 여기서 고른다. 비워 두면 agent/vlm.py의 DEFAULT_MODEL을 쓴다.
MODEL=anthropic/claude-sonnet-4.5
